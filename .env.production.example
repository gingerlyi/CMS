# Copy to .env on the server and fill in every value marked GANTI.
APP_NAME="Cover Multimedia Solution"
APP_ENV=production
# GANTI: generate with  docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://cms.documentation.my.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Port on 127.0.0.1 that Nginx / Nginx Proxy Manager forwards to
APP_PORT=8080


LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=cms
# GANTI: long random passwords
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# First admin account (created by: php artisan db:seed)
ADMIN_EMAIL=admin@documentation.my.id
# GANTI: strong password for the admin panel
ADMIN_PASSWORD=
